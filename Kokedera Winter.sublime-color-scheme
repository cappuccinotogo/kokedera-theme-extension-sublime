{
  "name": "Kokedera Winter",
  "author": "Kokedera",
  "globals": {
    "background": "#eef0ee",
    "foreground": "#323c36",
    "caret": "#1f8aa8",
    "accent": "#2e7a8a",
    "selection": "#d4dad4",
    "selection_foreground": "#323c36",
    "inactive_selection": "#e2e6e2",
    "line_highlight": "#e2e6e2",
    "gutter": "#eef0ee",
    "gutter_foreground": "#728a72",
    "guide": "#d2d7d2",
    "active_guide": "#c8cec8",
    "stack_guide": "#c8cec8",
    "find_highlight": "#c9d0c9",
    "find_highlight_foreground": "#323c36",
    "brackets_foreground": "#6b5c2a",
    "bracket_contents_foreground": "#6b5c2a",
    "tags_foreground": "#2e7a8a",
    "misspelling": "#a84848",
    "shadow": "#e9ecea",
    "shadow_width": 0,
    "line_diff_added": "#2f7846",
    "line_diff_modified": "#8a552e",
    "line_diff_deleted": "#a84848"
  },
  "rules": [
    {
      "scope": "comment",
      "foreground": "#7d8a80",
      "font_style": "italic"
    },
    {
      "scope": "string",
      "foreground": "#6b5c2a"
    },
    {
      "scope": "constant.numeric",
      "foreground": "#8a552e"
    },
    {
      "scope": "constant.language",
      "foreground": "#8a552e"
    },
    {
      "scope": "keyword, storage",
      "foreground": "#25708f"
    },
    {
      "scope": "variable",
      "foreground": "#4a6b5c"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#4a6b5c"
    },
    {
      "scope": "entity.name.function, support.function",
      "foreground": "#2f7846"
    },
    {
      "scope": "entity.name.type, support.type, support.class",
      "foreground": "#1f7d6b"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#4a6b5c"
    },
    {
      "scope": "keyword.operator, punctuation",
      "foreground": "#5e6b62"
    },
    {
      "scope": "string.regexp",
      "foreground": "#6b5a9a"
    },
    {
      "scope": "markup.heading",
      "foreground": "#2f7846",
      "font_style": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "#323c36",
      "font_style": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "#323c36",
      "font_style": "italic"
    },
    {
      "scope": "markup.inserted",
      "foreground": "#2f7846"
    },
    {
      "scope": "markup.deleted",
      "foreground": "#a84848"
    },
    {
      "scope": "markup.changed",
      "foreground": "#8a552e"
    },
    {
      "scope": "invalid",
      "foreground": "#a84848"
    },
    {
      "name": "Comments",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#7d8a80",
      "font_style": "italic"
    },
    {
      "name": "Doc comments",
      "scope": "comment.block.documentation, comment.block.javadoc",
      "foreground": "#6e7a70",
      "font_style": "italic"
    },
    {
      "name": "Doc comment tags",
      "scope": "comment.block.documentation storage.type, comment.block.javadoc keyword, comment.block.documentation punctuation.definition",
      "foreground": "#5e6b62",
      "font_style": "bold italic"
    },
    {
      "name": "Keywords",
      "scope": "keyword, keyword.control, keyword.operator.new, keyword.operator.delete, keyword.operator.expression, keyword.operator.typeof, keyword.operator.instanceof, storage.type, storage.modifier",
      "foreground": "#25708f"
    },
    {
      "name": "Strings",
      "scope": "string, string.quoted, string.template",
      "foreground": "#6b5c2a"
    },
    {
      "name": "String escape",
      "scope": "constant.character.escape",
      "foreground": "#6b5a9a",
      "font_style": "bold"
    },
    {
      "name": "Regex",
      "scope": "string.regexp",
      "foreground": "#6b5a9a"
    },
    {
      "name": "String special",
      "scope": "string.interpolated, punctuation.definition.template-expression, punctuation.section.embedded",
      "foreground": "#6b5c2a",
      "font_style": "italic"
    },
    {
      "name": "Numbers & Constants",
      "scope": "constant.numeric, constant.language, constant.character",
      "foreground": "#8a552e"
    },
    {
      "name": "Boolean",
      "scope": "constant.language.boolean",
      "foreground": "#8a552e",
      "font_style": "bold"
    },
    {
      "name": "Functions",
      "scope": "entity.name.function, support.function, meta.function-call entity.name.function",
      "foreground": "#2f7846"
    },
    {
      "name": "Function parameters",
      "scope": "variable.parameter",
      "foreground": "#4a6b5c"
    },
    {
      "name": "Types / Classes",
      "scope": "entity.name.type, entity.name.class, entity.other.inherited-class, support.type, support.class, entity.name.namespace, entity.name.module",
      "foreground": "#1f7d6b"
    },
    {
      "name": "Type builtin",
      "scope": "support.type.builtin, support.type.primitive",
      "foreground": "#1f7d6b",
      "font_style": "italic"
    },
    {
      "name": "Interfaces",
      "scope": "entity.name.type.interface",
      "foreground": "#1f7d6b"
    },
    {
      "name": "Enums",
      "scope": "entity.name.type.enum",
      "foreground": "#1f7d6b"
    },
    {
      "name": "Variables",
      "scope": "variable, variable.other, variable.other.readwrite",
      "foreground": "#4a6b5c"
    },
    {
      "name": "Variable constants",
      "scope": "variable.other.constant, variable.other.enummember",
      "foreground": "#8a552e"
    },
    {
      "name": "Variable - this/self",
      "scope": "variable.language.this, variable.language.self, variable.language.super",
      "foreground": "#2e7a8a",
      "font_style": "italic"
    },
    {
      "name": "Properties",
      "scope": "variable.other.property, variable.other.object.property, support.variable.property",
      "foreground": "#4a6b5c"
    },
    {
      "name": "Operators",
      "scope": "keyword.operator, punctuation.accessor, punctuation.separator",
      "foreground": "#5e6b62"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation.definition.block, punctuation.definition.parameters, punctuation.definition.arguments, punctuation.definition.array, punctuation.section, meta.brace",
      "foreground": "#5e6b62"
    },
    {
      "name": "Annotations / Decorators",
      "scope": "meta.decorator, meta.annotation, storage.type.annotation, punctuation.decorator",
      "foreground": "#2f7846"
    },
    {
      "name": "Labels",
      "scope": "entity.name.label",
      "foreground": "#2e7a8a"
    },
    {
      "name": "Tag names (HTML/XML/JSX)",
      "scope": "entity.name.tag, punctuation.definition.tag",
      "foreground": "#25708f"
    },
    {
      "name": "Tag attributes",
      "scope": "entity.other.attribute-name",
      "foreground": "#2f7846"
    },
    {
      "name": "Attribute values",
      "scope": "string.quoted.double.html, string.quoted.single.html",
      "foreground": "#6b5c2a"
    },
    {
      "name": "CSS property",
      "scope": "support.type.property-name.css, meta.property-name.css",
      "foreground": "#2e7a8a"
    },
    {
      "name": "CSS values",
      "scope": "support.constant.property-value.css, meta.property-value.css",
      "foreground": "#4a6b5c"
    },
    {
      "name": "CSS selectors",
      "scope": "entity.other.attribute-name.class.css, entity.other.attribute-name.id.css",
      "foreground": "#2f7846"
    },
    {
      "name": "CSS pseudo",
      "scope": "entity.other.attribute-name.pseudo-class.css, entity.other.attribute-name.pseudo-element.css",
      "foreground": "#1f7d6b"
    },
    {
      "name": "CSS units",
      "scope": "keyword.other.unit.css",
      "foreground": "#8a552e"
    },
    {
      "name": "JSON keys",
      "scope": "support.type.property-name.json",
      "foreground": "#2e7a8a"
    },
    {
      "name": "JSON values",
      "scope": "string.quoted.double.json",
      "foreground": "#6b5c2a"
    },
    {
      "name": "YAML keys",
      "scope": "entity.name.tag.yaml",
      "foreground": "#2e7a8a"
    },
    {
      "name": "YAML values",
      "scope": "string.unquoted.plain.out.yaml, string.quoted.single.yaml, string.quoted.double.yaml",
      "foreground": "#6b5c2a"
    },
    {
      "name": "YAML anchors",
      "scope": "entity.name.type.anchor.yaml, punctuation.definition.anchor.yaml, variable.other.alias.yaml",
      "foreground": "#1f7d6b"
    },
    {
      "name": "Markdown headings",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#25708f",
      "font_style": "bold"
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "foreground": "#323c36",
      "font_style": "bold"
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "foreground": "#323c36",
      "font_style": "italic"
    },
    {
      "name": "Markdown bold italic",
      "scope": "markup.bold markup.italic, markup.italic markup.bold",
      "font_style": "bold italic"
    },
    {
      "name": "Markdown code",
      "scope": "markup.inline.raw, markup.fenced_code, markup.raw.block",
      "foreground": "#6b5c2a"
    },
    {
      "name": "Markdown links",
      "scope": "markup.underline.link",
      "foreground": "#1f7d6b",
      "font_style": "italic"
    },
    {
      "name": "Markdown link text",
      "scope": "string.other.link",
      "foreground": "#357d70"
    },
    {
      "name": "Markdown list",
      "scope": "punctuation.definition.list.begin.markdown",
      "foreground": "#2e7a8a"
    },
    {
      "name": "Markdown quote",
      "scope": "markup.quote",
      "foreground": "#5e6b62",
      "font_style": "italic"
    },
    {
      "name": "Diff inserted",
      "scope": "markup.inserted",
      "foreground": "#2a7f9c"
    },
    {
      "name": "Diff deleted",
      "scope": "markup.deleted",
      "foreground": "#a84848"
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "foreground": "#7a6518"
    },
    {
      "name": "Invalid / Illegal",
      "scope": "invalid, invalid.illegal",
      "foreground": "#a84848"
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#5e6b62",
      "font_style": ""
    },
    {
      "name": "Emphasis",
      "scope": "emphasis",
      "font_style": "italic"
    },
    {
      "name": "Strong",
      "scope": "strong",
      "font_style": "bold"
    }
  ]
}
