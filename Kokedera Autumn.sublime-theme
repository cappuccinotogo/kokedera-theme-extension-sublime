{
  "extends": "Adaptive.sublime-theme",
  "rules": [
    {
      "class": "window",
      "layer0.tint": "#1a1511",
      "layer0.opacity": 1
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#261e19",
      "layer0.opacity": 1
    },
    {
      "class": "sidebar_tree",
      "layer0.tint": "#261e19",
      "layer0.opacity": 1
    },
    {
      "class": "sidebar_heading",
      "fg": "#c48c6c"
    },
    {
      "class": "sidebar_label",
      "fg": "#aa9287"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#d8c1b8"
    },
    {
      "class": "tree_row",
      "layer0.tint": "#453930",
      "layer0.opacity": 1,
      "attributes": [
        "selected"
      ]
    },
    {
      "class": "tabset_control",
      "layer0.tint": "#261e19",
      "layer0.opacity": 1
    },
    {
      "class": "tab_control",
      "layer0.tint": "#261e19",
      "layer0.opacity": 1
    },
    {
      "class": "tab_control",
      "layer0.tint": "#1a1511",
      "layer0.opacity": 1,
      "attributes": [
        "selected"
      ]
    },
    {
      "class": "tab_label",
      "fg": "#aa9287"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#d8c1b8"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#261e19",
      "layer0.opacity": 1
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "fg": "#aa9287"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#1e1814",
      "layer0.opacity": 1
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#1e1814",
      "layer0.opacity": 1
    },
    {
      "class": "quick_panel",
      "layer0.tint": "#1e1814",
      "layer0.opacity": 1
    },
    {
      "class": "quick_panel_row",
      "layer0.tint": "#453930",
      "layer0.opacity": 1,
      "attributes": [
        "selected"
      ]
    },
    {
      "class": "mini_quick_panel_row",
      "layer0.tint": "#453930",
      "layer0.opacity": 1,
      "attributes": [
        "selected"
      ]
    },
    {
      "class": "quick_panel_label",
      "fg": "#d8c1b8",
      "match_fg": "#c48c6c",
      "selected_fg": "#d8c1b8",
      "selected_match_fg": "#c48c6c"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#aa9287",
      "match_fg": "#c48c6c",
      "selected_fg": "#aa9287",
      "selected_match_fg": "#c48c6c"
    },
    {
      "class": "scroll_bar",
      "layer0.tint": "#261e19",
      "layer0.opacity": 1
    },
    {
      "class": "puck_control",
      "layer0.tint": "#4a3e35",
      "layer0.opacity": 1
    },
    {
      "class": "auto_complete",
      "layer0.tint": "#1e1814",
      "layer0.opacity": 1
    },
    {
      "class": "auto_complete_label",
      "fg": "#d8c1b8",
      "match_fg": "#c48c6c",
      "selected_fg": "#d8c1b8",
      "selected_match_fg": "#c48c6c"
    },
    {
      "class": "input_area",
      "layer0.tint": "#1a1511",
      "layer0.opacity": 1
    }
  ]
}
