{
  "extends": "Adaptive.sublime-theme",
  "rules": [
    {
      "class": "window",
      "layer0.tint": "#0c1a0b",
      "layer0.opacity": 1
    },
    {
      "class": "sidebar_container",
      "layer0.tint": "#112510",
      "layer0.opacity": 1
    },
    {
      "class": "sidebar_tree",
      "layer0.tint": "#112510",
      "layer0.opacity": 1
    },
    {
      "class": "sidebar_heading",
      "fg": "#56d165"
    },
    {
      "class": "sidebar_label",
      "fg": "#99ba86"
    },
    {
      "class": "sidebar_label",
      "parents": [
        {
          "class": "tree_row",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#d2e7bd"
    },
    {
      "class": "tree_row",
      "layer0.tint": "#214321",
      "layer0.opacity": 1,
      "attributes": [
        "selected"
      ]
    },
    {
      "class": "tabset_control",
      "layer0.tint": "#112510",
      "layer0.opacity": 1
    },
    {
      "class": "tab_control",
      "layer0.tint": "#112510",
      "layer0.opacity": 1
    },
    {
      "class": "tab_control",
      "layer0.tint": "#0c1a0b",
      "layer0.opacity": 1,
      "attributes": [
        "selected"
      ]
    },
    {
      "class": "tab_label",
      "fg": "#99ba86"
    },
    {
      "class": "tab_label",
      "parents": [
        {
          "class": "tab_control",
          "attributes": [
            "selected"
          ]
        }
      ],
      "fg": "#d2e7bd"
    },
    {
      "class": "status_bar",
      "layer0.tint": "#112510",
      "layer0.opacity": 1
    },
    {
      "class": "label_control",
      "parents": [
        {
          "class": "status_bar"
        }
      ],
      "fg": "#99ba86"
    },
    {
      "class": "panel_control",
      "layer0.tint": "#0e1d0d",
      "layer0.opacity": 1
    },
    {
      "class": "overlay_control",
      "layer0.tint": "#0e1d0d",
      "layer0.opacity": 1
    },
    {
      "class": "quick_panel",
      "layer0.tint": "#0e1d0d",
      "layer0.opacity": 1
    },
    {
      "class": "quick_panel_row",
      "layer0.tint": "#214321",
      "layer0.opacity": 1,
      "attributes": [
        "selected"
      ]
    },
    {
      "class": "mini_quick_panel_row",
      "layer0.tint": "#214321",
      "layer0.opacity": 1,
      "attributes": [
        "selected"
      ]
    },
    {
      "class": "quick_panel_label",
      "fg": "#d2e7bd",
      "match_fg": "#56d165",
      "selected_fg": "#d2e7bd",
      "selected_match_fg": "#56d165"
    },
    {
      "class": "quick_panel_path_label",
      "fg": "#99ba86",
      "match_fg": "#56d165",
      "selected_fg": "#99ba86",
      "selected_match_fg": "#56d165"
    },
    {
      "class": "scroll_bar",
      "layer0.tint": "#112510",
      "layer0.opacity": 1
    },
    {
      "class": "puck_control",
      "layer0.tint": "#2c4725",
      "layer0.opacity": 1
    },
    {
      "class": "auto_complete",
      "layer0.tint": "#0e1d0d",
      "layer0.opacity": 1
    },
    {
      "class": "auto_complete_label",
      "fg": "#d2e7bd",
      "match_fg": "#56d165",
      "selected_fg": "#d2e7bd",
      "selected_match_fg": "#56d165"
    },
    {
      "class": "input_area",
      "layer0.tint": "#0c1a0b",
      "layer0.opacity": 1
    }
  ]
}
